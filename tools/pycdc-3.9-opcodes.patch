+/* Look ahead from a SETUP_FINALLY handler target and classify it as an
+ * except-handler (contains JUMP_IF_NOT_EXC_MATCH / POP_EXCEPT, or -- for a
+ * bare `except:` -- opens by popping the exception triple) versus a pure
+ * finally-handler.  Python 3.8-3.10 carry no exception table, so unlike
+ * 3.11+ there is nothing to mark try/except vs try/finally up front; without
+ * this, the try body's POP_BLOCK wrongly injects a `finally: pass` before the
+ * except clause is ever seen. */
+static bool handler_is_except(PycRef<PycCode> code, PycModule* mod, int start)
+{
+    /* bc_next may read past a truncated tail and throw; never let a lookahead
+     * crash the decompilation -- fall back to "finally" (original behaviour). */
+    try {
+        PycBuffer buf(code->code()->value(), code->code()->length());
+        int opcode = 0, operand = 0, pos = 0;
+        while (pos < start && !buf.atEof())
+            bc_next(buf, mod, opcode, operand, pos);
+        for (int i = 0; i < 16 && !buf.atEof(); ++i) {
+            bc_next(buf, mod, opcode, operand, pos);
+            if (opcode == Pyc::JUMP_IF_NOT_EXC_MATCH_A || opcode == Pyc::POP_EXCEPT)
+                return true;
+            if (i == 0 && opcode == Pyc::POP_TOP)
+                return true;
+        }
+    } catch (...) {
+        return false;
+    }
+    return false;
+}
